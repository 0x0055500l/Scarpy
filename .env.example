# LLM Settings
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_USER_AGENT=
BROWSER_SCREENSHOTS=true
BROWSER_TRACING=false

# Engine Settings
MAX_RETRIES=3

# Database Settings
# For local dev: sqlite+aiosqlite:///./agent.db
# For production (docker): postgresql+asyncpg://user:password@db:5432/webagent
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Logging Settings
LOG_LEVEL=INFO
